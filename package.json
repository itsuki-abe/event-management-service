{
	"name": "event-management-service",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"preview": "bun run build && vite preview",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"deploy": "bun run build && wrangler deploy",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply DB --local",
		"cf-typegen": "wrangler types",
		"typecheck": "bun run generate-routes && bun run cf-typegen && tsc --noEmit",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"test:smoke": "node scripts/smoke.mjs"
	},
	"dependencies": {
		"@fontsource/zen-maru-gothic": "^5.3.1",
		"@phosphor-icons/react": "^2.1.10",
		"@tanstack/react-router": "1.170.45",
		"@tanstack/react-start": "1.169.3",
		"drizzle-orm": "^0.45.1",
		"qrcode.react": "^4.2.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@cloudflare/vite-plugin": "^1.26.0",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^26.6.5",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"wrangler": "^4.151.1",
		"@tailwindcss/vite": "^4.1.18",
		"drizzle-kit": "^0.31.9",
		"tailwindcss": "^4.1.18"
	},
	"packageManager": "bun@1.3.13",
	"engines": {
		"node": ">=22.12.0"
	}
}
