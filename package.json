{
	"name": "event-management-service",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"build:sites": "bun run build && node scripts/prepare-sites.mjs",
		"preview": "bun run build && vite preview",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check .",
		"deploy": "bun run build && wrangler deploy",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply DB --local",
		"cf-typegen": "wrangler types",
		"typecheck": "bun run generate-routes && bun run cf-typegen && tsc --noEmit",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"test:smoke": "node scripts/smoke.mjs",
		"test:lt": "node scripts/lt-smoke.mjs",
		"test:browser": "bun run build && node scripts/lt-browser.mjs",
		"test:venue:browser": "bun run build && node scripts/venue-browser.mjs",
		"db:seed": "wrangler d1 execute DB --local --file scripts/seed-local.sql",
		"test:engagement": "node scripts/engagement-smoke.mjs",
		"db:seed:engagement": "wrangler d1 execute DB --local --file scripts/seed-engagement.sql",
		"test": "bun test"
	},
	"dependencies": {
		"@fontsource/zen-maru-gothic": "^5.3.1",
		"@tanstack/react-router": "1.170.45",
		"@tanstack/react-start": "1.169.3",
		"drizzle-orm": "^0.45.1",
		"qrcode.react": "^4.2.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"zod": "^4.6.7",
		"@fontsource/material-symbols-rounded": "^5.3.9",
		"lucide-react": "^1.59.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@cloudflare/vite-plugin": "^1.26.0",
		"@playwright/test": "1.59.1",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/router-cli": "^1.132.0",
		"@types/node": "^26.6.5",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"drizzle-kit": "^0.31.9",
		"tailwindcss": "^4.1.18",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"wrangler": "^4.151.1",
		"miniflare": "5.20261012.1-beta"
	},
	"packageManager": "bun@1.3.13",
	"engines": {
		"node": ">=22.12.0"
	}
}
